{
  "version": 2,

  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },

  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],

  "buildCommand": "npm install && npm run build",

  "outputDirectory": "public/build"
}